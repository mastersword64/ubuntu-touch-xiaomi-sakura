+        tmp140__ |= ( pSrc->reserved << 2 );
+        tmp140__ |= ( pSrc->rxNSS << 4 );
+        tmp140__ |= ( pSrc->rxNSSType << 7 );
+        if (unlikely(nBuf < 1))
+            return DOT11F_INCOMPLETE_IE;
