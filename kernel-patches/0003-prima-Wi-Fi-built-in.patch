+  {\
+    _ucACMask = 0; \
+    for ( i = 0; i < WLANTL_NUM_TX_QUEUES; i++ ) \
+    { \
+      if ( 0 != (_pSTA)->aucACMask[i] ) \
+      { \
+        _ucACMask |= ( 1 << i ); \
+      } \
+    } \
+  } while (0);
