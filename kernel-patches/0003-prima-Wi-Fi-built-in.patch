+tANI_BOOLEAN csrIsNULLSSID( tANI_U8 *pBssSsid, tANI_U8 len )
+{
+    tANI_BOOLEAN fNullSsid = FALSE;
+
+    tANI_U32 SsidLength;
+    tANI_U8 *pSsidStr;
+
+    do
+    {
+        if ( 0 == len )
+        {
+            fNullSsid = TRUE;
+            break;
+        }
+
+        //Consider 0 or space for hidden SSID
+        if ( 0 == pBssSsid[0] )
+        {
+             fNullSsid = TRUE;
+             break;
+        }
+
+        SsidLength = len;
+        pSsidStr = pBssSsid;
+
+        while ( SsidLength )
+        {
+            if( *pSsidStr )
+                break;
+
+            pSsidStr++;
+            SsidLength--;
+        }
+
+        if( 0 == SsidLength )
+        {
+            fNullSsid = TRUE;
+            break;
+        }
+    }
+    while( 0 );
+
+    return fNullSsid;
+}
