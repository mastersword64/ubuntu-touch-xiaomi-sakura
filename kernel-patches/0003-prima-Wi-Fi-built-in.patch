+{
+    tpSwitchChannelParams pChnlParams = NULL;
+    tSirRetStatus   retCode = eSIR_SUCCESS;
+    tSirMsgQ msgQ;
+    tpPESession pSessionEntry;
+    if((pSessionEntry = peFindSessionBySessionId(pMac, peSessionId)) == NULL)
+    {
+       limLog( pMac, LOGP,
