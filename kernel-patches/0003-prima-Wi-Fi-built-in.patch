+
+/* 
+ * @note : Bytes is to print overflow message information.
+ */
+
+#include "palTypes.h"
+
+#ifdef ANI_LOGDUMP
+
+#define MAX_OVERFLOW_MSG    400
+#define MAX_LOGDUMP_SIZE    ((4*1024) - MAX_OVERFLOW_MSG)
+
+#if   defined(ANI_OS_TYPE_ANDROID)
+
+#include <linux/kernel.h>
