+    Get message buffer
+  -----------------------------------------------------------------------*/
+  if (( WDI_STATUS_SUCCESS != WDI_GetMessageBuffer( pWDICtx, WDI_SET_STA_KEY_REQ,
+                        sizeof(halSetStaKeyReqMsg.setStaKeyParams),
+                        &pSendBuffer, &usDataOffset, &usSendSize))||
