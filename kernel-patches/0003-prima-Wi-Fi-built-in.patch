+static tANI_U32 csrGetBssPreferValue(tpAniSirGlobal pMac, int rssi)
+{
+    tANI_U32 ret = 0;
+    int i = CSR_NUM_RSSI_CAT - 1;
+
+    while(i >= 0)
+    {
+        if(rssi >= pMac->roam.configParam.RSSICat[i])
+        {
+            ret = pMac->roam.configParam.BssPreferValue[i];
+            break;
+        }
+        i--;
+    };
+
+    return (ret);
+}
