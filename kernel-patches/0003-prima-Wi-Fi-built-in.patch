+WDI_Status 
+WDI_BmuGetQidForQOSTid
+(
+    wpt_uint8   ucTid, 
+    wpt_uint8*  pQid
+)
+{
+    if (ucTid > BTQM_QUEUE_TX_TID_7 )
+        return WDI_STATUS_E_FAILURE;
+        
+    *pQid = btqmQosTid2QidMapping[ucTid];
+    return WDI_STATUS_SUCCESS;
+}/*WDI_BmuGetQidForQOSTid*/
