+                "VPKT [%d]: Invalid magic", __LINE__);
+      return VOS_STATUS_E_INVAL;
+   }
+
+   // return the requested information
+   *pTstamp = pPacket->timestamp;
+   return VOS_STATUS_SUCCESS;
+}
