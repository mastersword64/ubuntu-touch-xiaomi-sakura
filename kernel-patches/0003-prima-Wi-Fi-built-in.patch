+v_U32_t btampPackTlvAMP_Assoc_Connected_Channel(void * pCtx,
+                                                tBtampTLVAMP_Assoc_Connected_Channel *pSrc,
+                                                v_U8_t *pBuf,
+                                                v_U32_t nBuf,
+                                                v_U32_t *pnConsumed)
+{
