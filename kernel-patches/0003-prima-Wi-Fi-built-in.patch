+       smsLog(pMac, LOGE, FL(" !!!!!!!!!!!!!!!!!!SessionId is hardcoded"));
+       status = csrRoamGetBKIDCache( pMac, 0, pNum, pBkidCache );
+       sme_ReleaseGlobalLock( &pMac->sme );
