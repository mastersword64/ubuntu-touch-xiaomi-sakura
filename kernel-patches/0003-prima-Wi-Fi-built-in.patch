+} tSuppRsnFsmConsts;
+
+
+/**
+ * This structure stores constants used by the AuthRsnGroupKeyFsm as
+ * defined in [802.11i].
+ */
+typedef struct tAuthRsnGroupKeyFsmConsts {
+    v_U32_t timeoutPeriod;
+    v_U32_t maxTries;
+} tAuthRsnGroupKeyFsmConsts;
+
+/**
