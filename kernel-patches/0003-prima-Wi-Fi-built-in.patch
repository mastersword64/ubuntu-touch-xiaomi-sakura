+            csrTdlsRemoveSmeCmd(pMac, eSmeCommandTdlsChannelSwitch);
+            break;
+        }
+        default:
+        {
+            break ;
+        }
+    }
+    
+    return eHAL_STATUS_SUCCESS ;
+}
