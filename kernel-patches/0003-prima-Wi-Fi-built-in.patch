+   if( ptt_sock_send_msg_to_app(&pHddCtx->ftm.wnl->wmsg, 0,
+                   ANI_NL_MSG_PUMAC, pHddCtx->ftm.wnl->nlh.nlmsg_pid, 0) < 0) {
