+/**
+ @brief WDI_SwapBytes - Swap Bytes of a given buffer
+  
+ @param  pBd:    buffer to be swapped 
+         nbSwap: number of bytes to swap
+  
+ @return   none
+*/
+WPT_STATIC WPT_INLINE void 
+WDI_SwapBytes
+(
+    wpt_uint8 *pBd, 
+    wpt_uint32 nbSwap
+)
+{
+  wpt_uint32 *pU32;
+  wpt_uint32 nU32;
+  wpt_uint32 wc;
+
+  nU32 = (((nbSwap) + 3)>>2);
+
+  pU32 = (wpt_uint32 *)pBd;
+  for ( wc = 0; wc < nU32; wc++ )
+  {
+    pU32[ wc ] = WPAL_BE32_TO_CPU( pU32[ wc ] );
+  }
+}/*WDI_SwapBytes*/
