+v_U8_t * 
+convertBSSIDToSSID
+(
+    v_U8_t *bssid  /* BSSID value */
+) 
+{
+    static v_U8_t ssId[32]; 
+
+    vos_mem_copy( 
+            ssId, 
+            bapSsidPrefixValue, 
+            4); 
+
+    vos_mem_copy( 
+            &ssId[4], 
+            bapBin2Hex(bssid, 6, '-'),
+            17); 
+
+    return ssId;
