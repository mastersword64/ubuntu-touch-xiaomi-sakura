+static void ccmComplete(tHddHandle hHdd, void *done)
+{
+    if (done)
+    {
+        (void)palSemaphoreGive(hHdd, done);
+    }
+}
+
+static void ccmWaitForCompletion(tHddHandle hHdd, void *done)
+{
+    if (done)
+    {
+        (void)palSemaphoreTake(hHdd, done);
+    }
+}
