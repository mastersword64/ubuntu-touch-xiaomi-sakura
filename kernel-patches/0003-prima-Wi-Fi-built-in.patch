+static v_S7_t   rssi;
+static v_S7_t   direction;
+void TLHS_UtestHandleNewRSSI(v_S7_t *newRSSI, v_PVOID_t pAdapter)
+{
+   if(0 == rssi)
+   {
+      direction = -1;
+   }
+   else if(-90 == rssi)
+   {
+      direction = 1;
+   }
+
+   *newRSSI = rssi;
+   rssi += direction;
+
+   return;
+}
