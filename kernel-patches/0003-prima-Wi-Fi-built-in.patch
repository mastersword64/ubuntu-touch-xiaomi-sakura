+   wpt_byte protVer :2;
+   wpt_byte type :2;
+   wpt_byte subType :4;
+
+   wpt_byte toDS :1;
+   wpt_byte fromDS :1;
+   wpt_byte moreFrag :1;
+   wpt_byte retry :1;
+   wpt_byte powerMgmt :1;
+   wpt_byte moreData :1;
