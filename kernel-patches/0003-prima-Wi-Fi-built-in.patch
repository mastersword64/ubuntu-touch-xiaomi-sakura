+
+        case SIR_MAC_RATE_72:
+            ConvertedRate = 144;
+            break;
+        case SIR_MAC_RATE_84:
+            ConvertedRate = 168;
+            break;
+        case SIR_MAC_RATE_96:
+            ConvertedRate = 192;
+            break;
+        case SIR_MAC_RATE_108:
+            ConvertedRate = 216;
+            break;
+        case SIR_MAC_RATE_126:
+            ConvertedRate = 252;
+            break;
+        case SIR_MAC_RATE_144:
+            ConvertedRate = 288;
