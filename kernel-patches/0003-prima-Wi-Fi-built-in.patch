+        pNoA->psSelection = pNoACmd->u.NoACmd.NoA.psSelection;
+        pNoA->sessionid = pNoACmd->u.NoACmd.NoA.sessionid;
+        msg.type = eWNI_SME_UPDATE_NOA;
+        msg.bodyval = 0;
+        msg.bodyptr = pNoA;
