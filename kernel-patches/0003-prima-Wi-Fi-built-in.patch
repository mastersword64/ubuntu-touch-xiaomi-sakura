+      pDelStaSelfReqParam->status = eSIR_FAILURE ;
+      WDA_SendMsg(pWDA, WDA_DEL_STA_SELF_RSP, (void *)pDelStaSelfReqParam, 0) ;
+   }
+   return status;
+}
