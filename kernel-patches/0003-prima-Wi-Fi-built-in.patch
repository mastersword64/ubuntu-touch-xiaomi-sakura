+                                       v_BOOL_t fAuthRequired,
+                                       v_BOOL_t fPrivacyBit,    
+                                       v_U8_t staId,
+                                       v_U8_t ucastSig,
+                                       v_U8_t bcastSig,
+                                       v_MACADDR_t *pPeerMacAddress,
+                                       v_BOOL_t fWmmEnabled);
