+ */
+
+
+void PopulateDot11fLinkIden(tpAniSirGlobal pMac, tpPESession psessionEntry, 
+                                 tDot11fIELinkIdentifier *linkIden,
+                                       tSirMacAddr peerMac, tANI_U8 reqType)
+{
