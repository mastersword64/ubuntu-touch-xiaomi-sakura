+tANI_BOOLEAN csrIsNetworkTypeEqual( tSirBssDescription *pSirBssDesc1, tSirBssDescription *pSirBssDesc2 )
+{
+    return( pSirBssDesc1->nwType == pSirBssDesc2->nwType );
+}
