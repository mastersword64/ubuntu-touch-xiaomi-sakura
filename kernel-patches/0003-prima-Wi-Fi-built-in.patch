+        BTAMP_MEMCPY(pCtx, pOut, &pIn, 4);
+    }
+    else
+    {
+        *pOut         = ( pIn & 0xff000000 ) >> 24;
+        *( pOut + 1 ) = ( pIn & 0x00ff0000 ) >> 16;
+        *( pOut + 2 ) = ( pIn & 0x0000ff00 ) >>  8;
+        *( pOut + 3 ) = ( pIn & 0x000000ff );
+    }
+#   else
+    if ( !fMsb )
+    {
+        *( pOut     ) = ( pIn & 0x000000ff );
+        *( pOut + 1 ) = ( pIn & 0x0000ff00 ) >>  8;
+        *( pOut + 2 ) = ( pIn & 0x00ff0000 ) >> 16;
+        *( pOut + 3 ) = ( pIn & 0xff000000 ) >> 24;
+    }
+    else
+    {
+        BTAMP_MEMCPY(pCtx, pOut, &pIn, 4);
+    }
+#   endif
+}
+
+typedef struct sTLVDefn {
+    v_U32_t   id;
+    v_U32_t   pec;
+    v_U32_t   minSize;
+    v_U32_t   maxSize;
+    size_t         offset;
+    size_t         presenceOffset;
+    v_U16_t   sig;
+    pfnGeneric_t   pfn;
+    const char *   name;
+    v_U8_t    fMandatory;
+} tTLVDefn;
+
+static tTLVDefn* FindTLVDefn( void *    pCtx,
+                              v_U8_t  *pBuf,
+                              v_U32_t  nBuf,
+                              tTLVDefn      TLVs[ ] )
+{
+    tTLVDefn    *pTlv;
+    v_U32_t      sType, sLen;
+    v_U32_t pec;
+    v_U16_t id;
+ 
+    sType = 1;
+    sLen  = 2;
+ 
+    (void)pCtx;
+ 
+    if (sType == 2) 
+        framesntohs( pCtx, &id, pBuf, 2 );
+    else {
+        id = *pBuf;
+    }
+
+    pTlv = &( TLVs[ 0 ] );
+    while ( 0xffff != pTlv->id )
+    {
+        if ( id == pTlv->id )
+        {
+            if ( 0 == pTlv->pec ) return pTlv;
+
+            if( nBuf > 5 )
+            {
+                pec =  ( ( * ( pBuf + 4 ) ) << 16 ) |
+                       ( ( * ( pBuf + 5 ) ) <<  8 ) |
+                           * ( pBuf + 6 );
+                if ( pec == pTlv->pec )
+                {
+                    return pTlv;
+                }
+            }
+        }
+
+        ++pTlv;
+    }
+
+    return NULL;
+}
