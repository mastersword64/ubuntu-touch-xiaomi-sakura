+                                    ((a & 0x00FF0000) >> 8)  |    \
+                                    ((a & 0xFF000000) >> 24))
+#else
+/* If DXE HW does not need endian swap, DO NOTHING */
+#define WLANDXE_U32_SWAP_ENDIAN(a) (a)
