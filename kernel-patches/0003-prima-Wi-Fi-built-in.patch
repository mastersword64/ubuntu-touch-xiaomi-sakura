+         callbackStatus);
+      vos_mem_free(pRequestBmpsEntry);
+      pEntry = csrLLRemoveHead(&pMac->pmc.requestBmpsList, FALSE);
+   }
+   csrLLUnlock(&pMac->pmc.requestBmpsList);
+}
