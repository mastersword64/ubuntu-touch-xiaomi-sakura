+/**=========================================================================
+  
+  \file  wlan_qct_pal_sync.c
+  
+  \brief Implementation trace/logging APIs PAL exports. wpt = (Wlan Pal Type) wpal = (Wlan PAL)
+               
+   Definitions for platform Windows and with legacy UMAC.
