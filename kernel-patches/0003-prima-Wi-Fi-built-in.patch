+
+/*-------------------------------------------------------------------------
+  Configuration Parameter min, max, defaults
+-------------------------------------------------------------------------*/
+
+/* WDI_CFG_CURRENT_TX_ANTENNA */
+#define WDI_CFG_CURRENT_TX_ANTENNA_STAMIN          1
+#define WDI_CFG_CURRENT_TX_ANTENNA_STAMAX          1
