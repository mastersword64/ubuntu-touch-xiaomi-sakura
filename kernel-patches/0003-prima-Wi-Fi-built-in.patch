+    cfgValue = SYS_MS_TO_TICKS(cfgValue);
+
+    /* Limiting max numm of probe req for each channel scan */
+    pMac->lim.maxProbe = (cfgValue/cfgValue1);
+
+    if (tx_timer_create(&pMac->lim.limTimers.gLimMaxChannelTimer,
