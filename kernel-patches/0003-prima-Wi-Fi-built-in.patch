+      pTLCb->atlSTAClients[ucSTAId].uLinkQualityAvg =
+          (WLANHAL_RX_BD_GET_SNR( pvBDHeader ) +  
+           pTLCb->atlSTAClients[ucSTAId].uLinkQualityAvg)/2;
+    }/*Else, first data packet*/
+ #endif
+  }/*BT-AMP data packet*/
+
+  return VOS_FALSE; 
+}/*WLANTL_ProcessBAPFrame*/
