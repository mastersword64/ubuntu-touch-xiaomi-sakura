+tANI_U8 csrToUpper( tANI_U8 ch )
+{
+    tANI_U8 chOut;
+
+    if ( ch >= 'a' && ch <= 'z' )
+    {
+        chOut = ch - 'a' + 'A';
+    }
+    else
+    {
+        chOut = ch;
+    }
+    return( chOut );
+}
