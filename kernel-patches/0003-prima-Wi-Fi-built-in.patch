+v_VOID_t vos_core_return_msg
+(
+  v_PVOID_t      pVContext, 
+  pVosMsgWrapper pMsgWrapper
+)
+{
+  pVosContextType pVosContext = (pVosContextType) pVContext;
+  
+  VOS_ASSERT( gpVosContext == pVosContext);
+
+  if (gpVosContext != pVosContext)
