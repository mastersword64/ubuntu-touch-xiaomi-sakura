+    tANI_U8 rate : 4;
+
+    tANI_U8 lengthMid : 8;
+
+    tANI_U8 tail: 6;
+    tANI_U8 parity : 1;
+    tANI_U8 lengthHi : 1;
+
+    tANI_U8 serviceLo;
+    tANI_U8 serviceHi;
+#else
+    tANI_U8 rate : 4;
+    tANI_U8 reserved : 1;
+    tANI_U8 lengthLo : 3;
+
+    tANI_U8 lengthMid : 8;
+
+    tANI_U8 lengthHi : 1;
+    tANI_U8 parity : 1;
+    tANI_U8 tail: 6;
+
+    tANI_U8 serviceLo;
+    tANI_U8 serviceHi;
+#endif
+} __ani_attr_packed tSirPhy11aHdr, *tpSirPhy11aHdr;
