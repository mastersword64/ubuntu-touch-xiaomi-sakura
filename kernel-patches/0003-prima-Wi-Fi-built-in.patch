+/* ---------------------------------------------------------------------------
+    \brief  This function returns TRUE if preauth is completed 
+
+    \param  pMac - The handle returned by macOpen.
+
+    \return boolean
+
+---------------------------------------------------------------------------*/
+tANI_BOOLEAN csrNeighborRoamStatePreauthDone(tpAniSirGlobal pMac)
+{
