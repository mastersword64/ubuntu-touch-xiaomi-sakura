index 00000000..e82dd006
--- /dev/null
+++ b/drivers/staging/prima/CORE/VOSS/inc/vos_mq.h
@@ -0,0 +1,273 @@
+/*
+ * Copyright (c) 2012-2013 The Linux Foundation. All rights reserved.
