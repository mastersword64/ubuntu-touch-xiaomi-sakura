+            pBuf += 2;
+            tlvlen -= (v_U8_t)2;
+        break;
+        case 0x0c61:
+            pDst->cc_event.Read_Logical_Link_Accept_TO.status = *pBuf;
+            pBuf += 1;
+            tlvlen -= (v_U8_t)1;
+            framesntohs(pCtx, &pDst->cc_event.Read_Logical_Link_Accept_TO.logical_link_accept_timeout, pBuf, 0);
+            pBuf += 2;
+            tlvlen -= (v_U8_t)2;
+        break;
+        case 0x0c62:
