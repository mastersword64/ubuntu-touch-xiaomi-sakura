+} tSuppFsmConsts;
+
+/**
+ * This structure stores constants used by the SuppRsnFsm as defined in
+ * [802.11i].
+ */
+typedef struct tSuppRsnFsmConsts {
+    v_U32_t timeoutPeriod;
