+    if ( WLAN_BAP_PAL_AMP_ASSOC_CONN_CH_TLV_MIN_LEN > tlvlen ) 
+    {
+#ifdef WLAN_BAPHCI_ENABLE_LOGGING
+      /*Log invalid len*/
