+  *-------------------------------------------------------------------------*/
+static wpt_status dxeRXFrameSingleBufferAlloc
+(
+   WLANDXE_CtrlBlkType      *dxeCtxt,
+   WLANDXE_ChannelCBType    *channelEntry,
+   WLANDXE_DescCtrlBlkType  *currentCtrlBlock
+);
+
+static wpt_status dxeNotifySmsm
+(
+  wpt_boolean kickDxe,
+  wpt_boolean ringEmpty
+);
+
