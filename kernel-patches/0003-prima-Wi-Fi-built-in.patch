+
+/* Offload request. */
+typedef struct
+{
+    v_U8_t offloadType;
+    v_U8_t enableOrDisable;
+    union
+    {
+        v_U8_t hostIpv4Addr [4];
+        v_U8_t hostIpv6Addr [16];
+    } params;
+    v_MACADDR_t bssId;
+} tHostOffloadRequest, *tpHostOffloadRequest;
