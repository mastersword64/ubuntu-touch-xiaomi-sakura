+    fHcfSupported = ((tANI_BOOLEAN)(PROP_CAPABILITY_GET( WME, pIeAirgo->PropCapability.capability )) ||
+        (pIeAirgo->present && pIeAirgo->HCF.present && pIeAirgo->HCF.enabled));
+
+    return( fHcfSupported );
+}
