+            break;
+        case SIR_MAC_RATE_18:
+            ConvertedRate = 36;
+            break;
+        case SIR_MAC_RATE_24:
+            ConvertedRate = 48;
+            break;
+        case SIR_MAC_RATE_36:
+            ConvertedRate = 72;
+            break;
+        case SIR_MAC_RATE_42:
+            ConvertedRate = 84;
+            break;
+        case SIR_MAC_RATE_48:
+            ConvertedRate = 96;
+            break;
+        case SIR_MAC_RATE_54:
+            ConvertedRate = 108;
