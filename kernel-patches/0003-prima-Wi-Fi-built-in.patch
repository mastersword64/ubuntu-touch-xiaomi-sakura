+  --------------------------------------------------------------------------*/
+VOS_STATUS vos_rand_get_bytes( v_U32_t cryptHandle, v_U8_t *pbBuf, v_U32_t numBytes )
+{
+   VOS_STATUS uResult = VOS_STATUS_E_FAILURE;
