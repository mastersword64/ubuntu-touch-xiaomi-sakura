+      pSwitchChanParams->status = eSIR_FAILURE ;
+      WDA_SendMsg(pWDA, WDA_SWITCH_CHANNEL_RSP,
+            (void *)pSwitchChanParams, 0) ;
+   }
+   return CONVERT_WDI2VOS_STATUS(status) ;
+}
