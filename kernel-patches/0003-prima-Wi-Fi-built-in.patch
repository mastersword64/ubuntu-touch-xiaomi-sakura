+typedef struct sTLVDefn {
+    tANI_U32   offset;
+    tANI_U32   presenceOffset;
+    const char *   name;
+    tANI_U16   sig;
+    tANI_U32   id;
+    tANI_U32   pec;
+    tANI_U32   minSize;
+    tANI_U32   maxSize;
+    tANI_U8    fMandatory;
+    tANI_U8    sType;
+    tANI_U8    sLen;
+    tANI_U8    fMsb;
+} tTLVDefn;
+
+static const tTLVDefn* FindTLVDefn( tpAniSirGlobal    pCtx,
+                              tANI_U8  *pBuf,
+                              tANI_U32  nBuf,
+                              const tTLVDefn      TLVs[ ] )
+{
+    const tTLVDefn *pTlv;
+    tANI_U32   pec;
+    tANI_U16   id;
+
+    pTlv = &( TLVs[ 0 ] );
+    (void)pCtx;
+    if ( pTlv->sType == 2 )
+       framesntohs( pCtx, &id, pBuf, 1 );
+    else
+       id = *pBuf;
+
+    while ( 0xffff != pTlv->id )
+    {
+        if ( id == pTlv->id )
+        {
+            if ( 0 == pTlv->pec ) return pTlv;
+
+            if( nBuf > 5 )
+            {
+                pec =  ( ( * ( pBuf + 4 ) ) << 16 ) |
+                       ( ( * ( pBuf + 5 ) ) <<  8 ) |
+                           * ( pBuf + 6 );
+                if ( pec == pTlv->pec )
+                {
+                    return pTlv;
+                }
+            }
+        }
+
+        ++pTlv;
+    }
+
+    return NULL;
+}
