+         NvTablesFromBin[i][j].offset = 0;
+         NvTablesFromBin[i][j].fieldFullName[0] = nul;
+         NvTablesFromBin[i][j].fieldFullName[1] = nul;
+         NvTablesFromBin[i][j].fieldFullName[2] = nul;
