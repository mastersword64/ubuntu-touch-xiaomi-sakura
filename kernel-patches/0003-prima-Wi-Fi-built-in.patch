+           v_U32_t textLen, /* length of data stream */
+           v_U8_t *key, /* pointer to authentication key */
+           v_U32_t keyLen, /* length of authentication key */
+           v_U8_t digest[VOS_DIGEST_MD5_SIZE]);/* caller digest to be filled in */
+
+
+
