+    tAniPacket *lastEapol;  //Tx
+    v_BOOL_t fReceiving;
+    v_U32_t cryptHandle;
+
+    // Timers used..alternate them in different states
+    vos_timer_t msg2Timer;
+    vos_timer_t msg4Timer;
+    v_BOOL_t msg2TimeOut;
+    v_BOOL_t msg4TimeOut;
