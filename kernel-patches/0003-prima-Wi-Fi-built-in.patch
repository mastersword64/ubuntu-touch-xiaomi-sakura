+WLANTL_MgmtFrmRxDefaultCb
+(
+  v_PVOID_t  pvosGCtx,
+  v_PVOID_t  vosBuff
+)
+{
+  if ( NULL != vosBuff )
+  {
+    TLLOGP(VOS_TRACE( VOS_MODULE_ID_TL, VOS_TRACE_LEVEL_FATAL,
+             "WLAN TL:Fatal failure: No registered Mgmt Frm client on pkt RX"));
