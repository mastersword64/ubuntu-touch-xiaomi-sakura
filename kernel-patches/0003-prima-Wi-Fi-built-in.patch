+static
+int checkPeerReplayCounter(tSuppRsnFsm *fsm, 
+                           tAniEapolKeyAvailEventData *data,
+                           v_BOOL_t *retransmit,
+                           v_BOOL_t actualMicFlag,
+                           v_BOOL_t reTxMicFlag
+                           );
