+            tlvlen -= (v_U8_t)1;
+            framesntohs(pCtx, &pDst->cc_event.Read_Link_Supervision_TO.log_link_handle, pBuf, 0);
+            pBuf += 2;
+            tlvlen -= (v_U8_t)2;
+            framesntohs(pCtx, &pDst->cc_event.Read_Link_Supervision_TO.link_supervision_timeout, pBuf, 0);
