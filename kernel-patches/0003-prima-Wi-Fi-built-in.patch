+/*===============================================================================
+  FUNCTION      WLANTL_PostResNeeded
+     
+  DESCRIPTION   This function posts message to TL to reserve BD/PDU memory
+ 
+  DEPENDENCIES  None
+                          
+  PARAMETERS    pvosGCtx
+                                       
+  RETURN        None
+
+  SIDE EFFECTS   none
+ ===============================================================================*/
+
+void WLANTL_PostResNeeded(v_PVOID_t pvosGCtx)
+{
+  vos_msg_t            vosMsg;
+
+  vosMsg.reserved = 0;
+  vosMsg.bodyptr  = NULL;
+  vosMsg.type     = WLANTL_TX_RES_NEEDED;
