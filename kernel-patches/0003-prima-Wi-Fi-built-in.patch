+int wlan_logging_sock_deinit_svc(void)
+{
+	gwlan_logging.pcur_node = NULL;
+	gwlan_logging.pkt_stats_pcur_node = NULL;
+	gapp_pid = INVALID_PID;
+
+	wlan_deinit_log_completion();
+	return 0;
+}
