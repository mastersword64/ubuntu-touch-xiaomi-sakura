+            break;
+        }
+        case eWNI_SME_TDLS_LINK_ESTABLISH_RSP:
+        {
+            tSirTdlsLinkEstablishReqRsp *linkEstablishReqRsp = (tSirTdlsLinkEstablishReqRsp *) pMsgBuf ;
+            tCsrRoamInfo roamInfo = {0} ;
+#if 0
+            vos_mem_copy(&roamInfo.peerMac, delStaRsp->peerMac,
