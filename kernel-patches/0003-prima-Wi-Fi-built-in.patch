+//   HCRYPTPROV hCryptProv = (HCRYPTPROV) cryptHandle;
+
+   //check for invalid pointer
+   if ( NULL == pbBuf )
+   {
+      uResult = VOS_STATUS_E_FAULT;
+      return ( uResult );
+   }
+
+//#if 0
+   // get_random_bytes() is a void procedure
+   get_random_bytes( pbBuf, numBytes);
+   // "Random sequence generated."
