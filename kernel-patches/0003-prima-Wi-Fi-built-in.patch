+        {
+            PELOG1(limLog(pMac, LOG1, FL(" => Rifs protection Disabled"));)
+            pBeaconParams->fRIFSMode = psessionEntry->beaconParams.fRIFSMode = true;
+            pBeaconParams->paramChangeBitmap |= PARAM_RIFS_MODE_CHANGED;
