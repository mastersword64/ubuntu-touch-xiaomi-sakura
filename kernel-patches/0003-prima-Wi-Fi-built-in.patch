+                                          "<------ %s " ,__func__);
+   pGetPEStatsRspParams = 
+       (tAniGetPEStatsRsp *)vos_mem_malloc(sizeof(tAniGetPEStatsRsp) +
+       (wdiGetStatsRsp->usMsgLen - sizeof(WDI_GetStatsRspParamsType)));
+
+   if(NULL == pGetPEStatsRspParams)
