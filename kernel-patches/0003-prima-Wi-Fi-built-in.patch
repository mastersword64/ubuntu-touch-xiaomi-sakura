+                         tANI_U32 *pnConsumed)
+{
+    tANI_U8* pIeLen = 0;
+    tANI_U32 n, idx = 0,idxlast;
+    tANI_U32 nConsumedSoFar, nConsumedNow;
+    tANI_U32 status = DOT11F_PARSE_SUCCESS;
+    tANI_U32 nNeeded = 0U;
+    status = dot11fGetPackedIEWSC(pCtx, pSrc, &nNeeded);
