+   status = WDI_GetStatsReq(&wdiGetStatsParam, 
+       (WDI_GetStatsRspCb)WDA_GetStatsReqParamsCallback, pWDA);
+   if(IS_WDI_STATUS_FAILURE(status))
+   {
