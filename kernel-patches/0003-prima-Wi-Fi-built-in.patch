+            pMac->p2pContext.probeRspIeLength = 0;
+            status = eHAL_STATUS_FAILURE;
+        }
+        else
+        {
+            pMac->p2pContext.probeRspIeLength = p2pIeLength;
+
+            sirDumpBuf( pMac, SIR_LIM_MODULE_ID, LOG2,
+                        pMac->p2pContext.probeRspIe,
