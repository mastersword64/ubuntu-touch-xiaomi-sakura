+#define __WLAN_QCT_PAL_TRACE_H
+
+/**=========================================================================
+  
+  \file  wlan_qct_pal_api.h
+  
+  \brief define general APIs PAL exports. wpt = (Wlan Pal Type) wpal = (Wlan PAL)
+               
+   Definitions for platform independent
+  
