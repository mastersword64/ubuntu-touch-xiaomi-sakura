+   pGetPEStatsRspParams->statsMask = wdiGetStatsRsp->uStatsMask;
+   vos_mem_copy( pGetPEStatsRspParams + 1,
+                  wdiGetStatsRsp + 1,
+                  wdiGetStatsRsp->usMsgLen - sizeof(WDI_GetStatsRspParamsType));
