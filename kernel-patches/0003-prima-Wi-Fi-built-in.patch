+   pGetPEStatsRspParams->msgType = eWNI_SME_GET_STATISTICS_RSP;
+   pGetPEStatsRspParams->msgLen = sizeof(tAniGetPEStatsRsp) + 
+                   (wdiGetStatsRsp->usMsgLen - sizeof(WDI_GetStatsRspParamsType));
