+
+enum
+{
+   VOS_FALSE = 0, 
+   VOS_TRUE  = ( !VOS_FALSE )
+};
+
+/// pointer to void types
+typedef v_VOID_t *v_PVOID_t;
+
+/// "Size" type... 
+typedef v_UINT_t v_SIZE_t;
+
+/// 'Time' type
