+
+           hddLog(VOS_TRACE_LEVEL_INFO,
+                  FL("GETBCNMISSRATE: bcnMissRate: %d"), priv->bcn_miss_rate);
+
+           if (priv->bcn_miss_rate == -1) {
+               ret = -EFAULT;
