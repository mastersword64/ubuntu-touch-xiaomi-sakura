+           }
+
+       } else if (strncmp(command, "TDLSOFFCHANNELMODE", 18) == 0) {
+           tANI_U8 *value = command;
+           int set_value;
+
+           ret = hdd_drv_cmd_validate(command, 18);
+           if (ret)
+               goto exit;
+
+           /* Move pointer to ahead of tdlsoffchnmode*/
+           value += 18;
+           ret = sscanf(value, "%d", &set_value);
