+#include "wlan_qct_os_type.h"
+
+typedef wpt_uint8 wpt_macAddr[6];
+
+enum
+{
+   eWLAN_PAL_FALSE = 0,
+   eWLAN_PAL_TRUE = 1,
+};
+
+typedef enum
+{
+   eWLAN_MODULE_DAL,
+   eWLAN_MODULE_DAL_CTRL,
+   eWLAN_MODULE_DAL_DATA,
