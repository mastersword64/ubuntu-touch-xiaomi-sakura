+eHalStatus csrRoamSetKey( tpAniSirGlobal pMac, tANI_U32 sessionId, tCsrRoamSetKey *pSetKey, tANI_U32 roamId )
+{
+    eHalStatus status;
+ 
+    if( !csrIsSetKeyAllowed(pMac, sessionId) )
+    {
+        status = eHAL_STATUS_CSR_WRONG_STATE;
+    }
+    else
+    {
