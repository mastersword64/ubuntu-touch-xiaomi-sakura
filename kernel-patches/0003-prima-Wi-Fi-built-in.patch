+           ( ( in & 0x08000000 ) >> 23 ) |
+           ( ( in & 0x04000000 ) >> 21 ) |
+           ( ( in & 0x02000000 ) >> 19 ) |
+           ( ( in & 0x01000000 ) >> 17 ) |
+           ( ( in & 0x00800000 ) >> 15 ) |
+           ( ( in & 0x00400000 ) >> 13 ) |
+           ( ( in & 0x00200000 ) >> 11 ) |
+           ( ( in & 0x00100000 ) >>  9 ) |
+           ( ( in & 0x00080000 ) >>  7 ) |
+           ( ( in & 0x00040000 ) >>  5 ) |
+           ( ( in & 0x00020000 ) >>  3 ) |
+           ( ( in & 0x00010000 ) >>  1 ) |
+           ( ( in & 0x00008000 ) <<  1 ) |
+           ( ( in & 0x00004000 ) <<  3 ) |
+           ( ( in & 0x00002000 ) <<  5 ) |
+           ( ( in & 0x00001000 ) <<  7 ) |
+           ( ( in & 0x00000800 ) <<  9 ) |
+           ( ( in & 0x00000400 ) << 11 ) |
+           ( ( in & 0x00000200 ) << 13 ) |
+           ( ( in & 0x00000100 ) << 15 ) |
+           ( ( in & 0x00000080 ) << 17 ) |
+           ( ( in & 0x00000040 ) << 19 ) |
+           ( ( in & 0x00000020 ) << 21 ) |
+           ( ( in & 0x00000010 ) << 23 ) |
+           ( ( in & 0x00000008 ) << 25 ) |
+           ( ( in & 0x00000004 ) << 27 ) |
+           ( ( in & 0x00000002 ) << 29 ) |
+           ( ( in & 0x00000001 ) << 31 );
