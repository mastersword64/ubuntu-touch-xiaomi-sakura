+      default:
+      {
+         VOS_TRACE( VOS_MODULE_ID_WDA, VOS_TRACE_LEVEL_INFO,
+                                  "No Handling for msg type %x in WDA " 
+                                  ,pMsg->type);
+         /* Do Nothing? MSG Body should be freed at here */
+         if(NULL != pMsg->bodyptr)
+         {
+            vos_mem_free(pMsg->bodyptr);
+         }
+         //WDA_VOS_ASSERT(0) ;
+      }
+   }
+   return status ;
