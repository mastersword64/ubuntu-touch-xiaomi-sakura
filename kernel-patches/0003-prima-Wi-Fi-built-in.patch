+tANI_BOOLEAN csrIsConcurrentInfraConnected( tpAniSirGlobal pMac )
+{
+    tANI_U32 i, noOfConnectedInfra = 0;
+
+    tANI_BOOLEAN fRc = eANI_BOOLEAN_FALSE;
