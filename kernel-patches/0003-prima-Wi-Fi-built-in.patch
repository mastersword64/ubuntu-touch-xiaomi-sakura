+        pIeLen = pBuf;
+        ++pBuf; ++(*pnConsumed);
+        tmp141__ = 0U;
+        tmp141__ |= ( pSrc->ac_bk_traffic_aval << 0 );
+        tmp141__ |= ( pSrc->ac_be_traffic_aval << 1 );
+        tmp141__ |= ( pSrc->ac_vi_traffic_aval << 2 );
+        tmp141__ |= ( pSrc->ac_vo_traffic_aval << 3 );
+        tmp141__ |= ( pSrc->reserved << 4 );
+        if (unlikely(nBuf < 1))
+            return DOT11F_INCOMPLETE_IE;
